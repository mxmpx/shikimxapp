{
  "base": "http://localhost:5173",
  "viewports": [
    { "name": "mobile", "width": 390, "height": 844 },
    { "name": "tablet", "width": 768, "height": 1024 },
    { "name": "desktop", "width": 1440, "height": 900 }
  ],
  "crawl": { "enabled": false, "maxPages": 20, "maxDepth": 1, "exclude": ["/logout"] },
  "states": [
    { "name": "home", "steps": [] },

    {
      "name": "tab-catalog-anime",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Аниме\")" }
      ]
    },
    {
      "name": "tab-top100",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Топ 100\")" }
      ]
    },
    {
      "name": "tab-catalog-manga",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Манга\")" }
      ]
    },
    {
      "name": "tab-catalog-ranobe",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Ранобэ\")" }
      ]
    },
    {
      "name": "tab-forum",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Форум\")" }
      ]
    },
    {
      "name": "tab-clubs",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Клубы\")" }
      ]
    },
    {
      "name": "tab-collections",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Коллекции\")" }
      ]
    },
    {
      "name": "tab-critiques",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Рецензии\")" }
      ]
    },
    {
      "name": "tab-articles",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Статьи\")" }
      ]
    },
    {
      "name": "tab-users",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Пользователи\")" }
      ]
    },
    {
      "name": "tab-recommendations",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Рекомендации\")" }
      ]
    },
    {
      "name": "tab-calendar",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"главное меню разделов\"]", "button[aria-label*=\"меню разделов\"]"] },
        { "action": "expect", "selector": "div.reveal-pop" },
        { "action": "click", "selector": "div.reveal-pop button:has-text(\"Календарь\")" }
      ]
    },

    {
      "name": "mobile-home",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"Главная\"]", "nav.mobile-bottom-nav button:first-child"] }
      ]
    },
    {
      "name": "mobile-catalog",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"Каталог\"]", "nav.mobile-bottom-nav button:nth-child(2)"] }
      ]
    },
    {
      "name": "mobile-lists",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"списки\"]", "nav.mobile-bottom-nav button:nth-child(3)"] }
      ]
    },
    {
      "name": "mobile-forum",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"Форум\"]", "nav.mobile-bottom-nav button:nth-child(4)"] }
      ]
    },
    {
      "name": "mobile-sheet",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"все разделы\"]", "nav.mobile-bottom-nav button[aria-label*=\"Ещё\"]", "nav.mobile-bottom-nav button:last-child"] },
        { "action": "expect", "selector": ["div.mobile-sheet-content", "div.mobile-sheet-backdrop"] }
      ]
    },
    {
      "name": "mobile-sheet-forum",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["nav.mobile-bottom-nav button[aria-label*=\"все разделы\"]", "nav.mobile-bottom-nav button[aria-label*=\"Ещё\"]", "nav.mobile-bottom-nav button:last-child"] },
        { "action": "expect", "selector": "div.mobile-sheet-content" },
        { "action": "click", "selector": "div.mobile-sheet-content button:has-text(\"Форум\")" }
      ]
    },

    {
      "name": "modal-anime-card",
      "viewports": ["mobile", "tablet", "desktop"],
      "steps": [
        { "action": "click", "selector": ["main div[role=\"button\"]", "div[role=\"button\"]", ".anime-card", "div[tabindex=\"0\"]"] },
        { "action": "expect", "selector": ["[role=\"dialog\"]", "#anime-modal-title"] },
        { "action": "wait", "ms": 400 }
      ]
    },
    {
      "name": "search-overlay",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": "input#global-header-search" },
        { "action": "wait", "ms": 400 }
      ]
    },
    {
      "name": "mobile-search-overlay",
      "viewports": ["mobile", "tablet"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label=\"Поиск аниме и манги\"]", "button[aria-label*=\"Поиск\"]"] },
        { "action": "expect", "selector": "div.mobile-search-overlay" },
        { "action": "wait", "ms": 400 }
      ]
    },
    {
      "name": "theme-light",
      "steps": [
        {
          "action": "click",
          "selector": [
            "button[aria-label*=\"светлую тему\"]",
            "button[aria-label*=\"тёмную тему\"]"
          ]
        },
        { "action": "wait", "ms": 400 }
      ]
    },
    {
      "name": "profile-menu",
      "viewports": ["desktop"],
      "steps": [
        { "action": "click", "selector": ["button[aria-label*=\"Меню профиля\"]", "button[aria-label*=\"профиля\"]", "a[href=\"/login\"]"] },
        { "action": "wait", "ms": 400 }
      ]
    }
  ]
}
