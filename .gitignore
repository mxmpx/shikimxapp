# ==============================================================================
# Shiki MX App - .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
.env.local
!.env.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
/dist/
/build/
static/dist/
frontend/dist/
*.tsbuildinfo
docs/examples/**/dist/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Database & SQLite storage
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Cached media & runtime assets
static/img_cache/
.tempmediaStorage/

# Compiled asset bundles (auto-generated by build_assets.py)
static/bundle.js
static/bundle.css
static/mobile.js
static/mobile.css

# Logs
logs/
*.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# AI Prompts & Instructions
prompt*.md
prompt*.txt
prompts/
prompt/
*.prompt
*.prompt.md

# Scratch, temporary files & test artifacts
scratch/
/test_*.py
/test*.txt
/test*.deleted
*.bak
*.backup
*.tmp
*.temp
*.orig
sys_path.txt
extractors.txt
push.bat
push.ps1

# Node & Package Managers
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & AI Assistant metadata
.vscode/
.idea/
*.swp
*.swo
*~
.agents/
.gemini/
.claude/
.continue/
.kilo/
.cursor/
.system_generated/
for AI examples/
.flask_secret