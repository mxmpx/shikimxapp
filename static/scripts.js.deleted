const tabLoaded = {};
let cachedHistoryData = null;
let ratesDataCache = [];
let currentTargetType = localStorage.getItem('currentTargetType') || 'Anime';
let currentStatusFilter = localStorage.getItem('currentStatusFilter') || 'all';
let currentSortFilter = localStorage.getItem('currentSortFilter') || 'updated_at';

function showLoader() {
    const loader = document.getElementById('app-loader');
    if (loader) loader.classList.remove('hidden');
}

function hideLoader() {
    const loader = document.getElementById('app-loader');
    if (loader) loader.classList.add('hidden');
}

window.addEventListener('load', () => {
    setTimeout(hideLoader, 300);
});

function initTheme() {
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    updateThemeIcon(savedTheme);
}

function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    updateThemeIcon(next);
}

function updateThemeIcon(theme) {
    const btn = document.getElementById('theme-toggle-btn');
    if (btn) {
        btn.innerHTML = theme === 'dark' ? '<i class="ti ti-sun"></i>' : '<i class="ti ti-moon"></i>';
    }
}

function toggleAbout() {
    const container = document.getElementById('about-container');
    const btn = document.getElementById('toggle-about-btn');
    if (!container || !btn) return;

    if (container.classList.contains('collapsed')) {
        container.classList.remove('collapsed');
        btn.innerText = 'Свернуть';
    } else {
        container.classList.add('collapsed');
        btn.innerText = 'Показать полностью';
    }
}

async function openTab(tabId) {
    localStorage.setItem('activeTab', tabId);

    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

    const activeContent = document.getElementById(tabId);
    if (activeContent) activeContent.classList.add('active');

    const activeBtns = document.querySelectorAll(`.tab-btn[onclick*="'${tabId}'"]`);
    activeBtns.forEach(btn => btn.classList.add('active'));

    if (tabId === 'profile') return;

    if (tabId === 'history' && cachedHistoryData) {
        renderHistory(cachedHistoryData);
        tabLoaded['history'] = true;
        return;
    }

    if (tabLoaded[tabId]) return;

    const targetDiv = document.getElementById(tabId);
    showLoader();

    try {
        const res = await fetch(`/api/tab/${tabId}`);
        const data = await res.json();
        tabLoaded[tabId] = true;

        if (tabId === 'favourites') renderFavourites(data);
        else if (tabId === 'friends') renderFriends(data);
        else if (tabId === 'history') {
            cachedHistoryData = data;
            renderHistory(data);
        }
        else if (tabId === 'rates') {
            ratesDataCache = data;
            renderRatesView();
        }
        else if (tabId === 'explore') {
            renderExplore(data);
        }
    } catch (err) {
        if (targetDiv) targetDiv.innerHTML = `<p style="color: var(--danger);">Ошибка загрузки: ${err.message}</p>`;
    } finally {
        hideLoader();
    }
}

async function openTabWithFilter(type, status) {
    currentTargetType = type;
    currentStatusFilter = status;
    localStorage.setItem('currentTargetType', type);
    localStorage.setItem('currentStatusFilter', status);

    await openTab('rates');

    document.querySelectorAll('.type-btn').forEach(b => {
        b.classList.remove('active');
        if ((type === 'Anime' && b.textContent.includes('Аниме')) ||
            (type === 'Manga' && b.textContent.includes('Манга'))) {
            b.classList.add('active');
        }
    });

    updateFilterLabels();

    document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('active');
        if (b.getAttribute('onclick') && b.getAttribute('onclick').includes(`'${status}'`)) {
            b.classList.add('active');
        }
    });

    applyListFilters();
}

function buildImgUrl(src) {
    if (!src) return '';
    let path = '';
    if (typeof src === 'string') {
        path = src;
    } else if (typeof src === 'object' && src !== null) {
        path = src.original || src.x160 || src.x148 || src.x96 || src.preview || src.x80 || src.x48 || src.main || '';
    }

    if (!path || path === 'None' || path === '{}') return '';
    path = path.replace(/\/(x64|x32|preview)\//, '/original/');
    const fullUrl = path.startsWith('http') ? path : 'https://shikimori.io' + (path.startsWith('/') ? path : '/' + path);

    return `/cache/img?url=${encodeURIComponent(fullUrl)}`;
}

function renderHistoryItemHtml(item) {
    const target = item.target || {};
    const title = target.russian || target.name || '';
    const imgUrl = target.image ? buildImgUrl(target.image) : '';

    let targetUrl = '#';
    if (target.url) {
        targetUrl = target.url.startsWith('http') ? target.url : 'https://shikimori.io' + target.url;
    } else if (target.id) {
        targetUrl = `https://shikimori.io/animes/${target.id}`;
    }

    const dateStr = item.created_at ? new Date(item.created_at).toLocaleString('ru-RU', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
    }) : '';

    const thumbHtml = imgUrl 
        ? `<a href="${targetUrl}" target="_blank"><img src="${imgUrl}" alt="${title}" class="history-thumb" loading="lazy"></a>`
        : `<div class="history-thumb-placeholder"></div>`;

    return `
        <div class="history-item">
            ${thumbHtml}
            <div class="history-info">
                ${title ? `<a href="${targetUrl}" target="_blank" class="history-target">${title}</a>` : ''}
                <div class="history-desc">${item.description || '—'}</div>
            </div>
            <div class="history-date">${dateStr}</div>
        </div>
    `;
}

async function loadRecentHistory() {
    const container = document.getElementById('recent-history-list');
    if (!container) return;

    try {
        const res = await fetch('/api/tab/history');
        const data = await res.json();
        
        if (Array.isArray(data)) {
            cachedHistoryData = data;
        }

        if (!Array.isArray(data) || data.length === 0) {
            container.innerHTML = '<p style="color: var(--text-muted); margin: 0;">История пуста</p>';
            return;
        }

        const recent = data.slice(0, 4);
        container.innerHTML = recent.map(renderHistoryItemHtml).join('');
    } catch (err) {
        container.innerHTML = `<p style="color: var(--danger); margin: 0;">Не удалось загрузить историю</p>`;
    }
}

async function loadProfileFriendsClubs() {
    const container = document.getElementById('profile-friends-clubs-preview');
    if (!container) return;

    try {
        const res = await fetch('/api/tab/friends');
        const data = await res.json();
        const friends = data.friends || [];
        const clubs = data.clubs || [];

        if (!friends.length && !clubs.length) {
            container.innerHTML = '<p style="color: var(--text-muted); margin: 0; font-size: 13px;">Список пуст</p>';
            return;
        }

        const topFriends = friends.slice(0, 4);
        const topClubs = clubs.slice(0, 2);

        let html = '<div class="mini-friends-grid">';
        
        topFriends.forEach(f => {
            const name = f.nickname || f.name || '';
            const img = buildImgUrl(f.avatar || f.image);
            const url = `https://shikimori.io/${name}`;
            html += `
                <a href="${url}" target="_blank" class="mini-friend-item" title="${name}">
                    <img src="${img}" alt="${name}" loading="lazy">
                    <span>${name}</span>
                </a>
            `;
        });

        topClubs.forEach(c => {
            const name = c.name || '';
            const img = buildImgUrl(c.logo || c.image);
            const url = `https://shikimori.io/clubs/${c.id}`;
            html += `
                <a href="${url}" target="_blank" class="mini-friend-item club" title="${name}">
                    <img src="${img}" alt="${name}" loading="lazy">
                    <span>${name}</span>
                </a>
            `;
        });

        html += '</div>';
        container.innerHTML = html;
    } catch (err) {
        container.innerHTML = `<p style="color: var(--danger); margin: 0; font-size: 13px;">Ошибка загрузки</p>`;
    }
}

function renderFavourites(data) {
    const container = document.getElementById('favourites');
    const chars = data.characters || [];
    const animes = data.animes || [];
    const mangas = data.mangas || [];

    const buildGrid = (items, type) => {
        if (!items.length) return '<p style="color: var(--text-muted);">Пусто</p>';
        return `<div class="media-grid">` + items.map(item => {
            const title = item.russian || item.name || '';
            const img = buildImgUrl(item.image);
            const url = item.url ? (item.url.startsWith('http') ? item.url : 'https://shikimori.io' + item.url) : `https://shikimori.io/${type}/${item.id}`;
            return `
                <a href="${url}" target="_blank" class="media-item" title="${title}">
                    <img src="${img}" alt="${title}" loading="lazy">
                    <div class="media-title">${title}</div>
                </a>
            `;
        }).join('') + `</div>`;
    };

    container.innerHTML = `
        <h3><i class="ti ti-user-star"></i> Избранные персонажи (${chars.length})</h3>${buildGrid(chars, 'characters')}
        <h3 style="margin-top: 32px;"><i class="ti ti-movie"></i> Избранные Аниме (${animes.length})</h3>${buildGrid(animes, 'animes')}
        ${mangas.length ? `<h3 style="margin-top: 32px;"><i class="ti ti-book"></i> Избранная Манга (${mangas.length})</h3>${buildGrid(mangas, 'mangas')}` : ''}
    `;
}

function renderFriends(data) {
    const container = document.getElementById('friends');
    const friends = data.friends || [];
    const clubs = data.clubs || [];

    const buildGrid = (items, isUser = true) => {
        if (!items.length) return '<p style="color: var(--text-muted);">Пусто</p>';
        return `<div class="media-grid">` + items.map(item => {
            const name = item.nickname || item.name || '';
            const rawSrc = isUser ? (item.avatar || item.image) : (item.logo || item.image);
            const img = buildImgUrl(rawSrc);
            const url = isUser ? `https://shikimori.io/${name}` : `https://shikimori.io/clubs/${item.id}`;

            return `
                <a href="${url}" target="_blank" class="media-item" title="${name}">
                    <img src="${img}" alt="${name}" loading="lazy">
                    <div class="media-title">${name}</div>
                </a>
            `;
        }).join('') + `</div>`;
    };

    container.innerHTML = `
        <h3><i class="ti ti-users"></i> Друзья (${friends.length})</h3>${buildGrid(friends, true)}
        <h3 style="margin-top: 24px;"><i class="ti ti-building-community"></i> Клубы (${clubs.length})</h3>${buildGrid(clubs, false)}
    `;
}

function renderHistory(historyList) {
    const container = document.getElementById('history');
    if (!Array.isArray(historyList) || historyList.length === 0) {
        container.innerHTML = '<div class="card"><p style="color: var(--text-muted);">История пуста</p></div>';
        return;
    }

    container.innerHTML = `
        <div class="card">
            <div class="card-header">
                <h3><i class="ti ti-clock"></i> Вся история</h3>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                ${historyList.map(renderHistoryItemHtml).join('')}
            </div>
        </div>
    `;
}

function renderExplore(data) {
    const container = document.getElementById('explore');

    if (data.error) {
        container.innerHTML = `<div class="card"><p style="color: var(--danger);">Ошибка получения новостей: ${data.error}</p></div>`;
        return;
    }

    const latest = data.latest || [];
    const other = data.other || [];
    const fallbackItems = data.items || [];

    if (!latest.length && !other.length && !fallbackItems.length) {
        container.innerHTML = '<div class="card"><p style="color: var(--text-muted);">Новостей не найдено.</p></div>';
        return;
    }

    const buildNewsList = (items) => {
        return items.map(item => {
            const imgHtml = item.image 
                ? `<div class="news-thumb"><img src="${item.image}" alt="${item.title}" loading="lazy"></div>`
                : `<div class="news-thumb placeholder"><i class="ti ti-news"></i></div>`;

            const tagsHtml = (item.tags && item.tags.length) 
                ? `<div class="news-tags">${item.tags.map(t => `<span class="news-tag">${t}</span>`).join('')}</div>`
                : '';

            return `
                <a href="${item.url}" target="_blank" class="news-item-card">
                    ${imgHtml}
                    <div class="news-item-body">
                        <h4 class="news-item-title">${item.title}</h4>
                        ${tagsHtml}
                        <div class="news-item-meta">
                            ${item.author ? `<span class="news-author"><i class="ti ti-user"></i> ${item.author}</span>` : ''}
                            ${item.date ? `<span class="news-date"><i class="ti ti-calendar"></i> ${item.date}</span>` : ''}
                        </div>
                    </div>
                </a>
            `;
        }).join('');
    };

    let html = '';

    if (latest.length) {
        html += `
            <div class="card" style="margin-bottom: 20px;">
                <div class="card-header">
                    <h3><i class="ti ti-news"></i> Главные новости</h3>
                </div>
                <div class="news-feed-list">
                    ${buildNewsList(latest)}
                </div>
            </div>
        `;
    }

    if (other.length) {
        html += `
            <div class="card">
                <div class="card-header">
                    <h3><i class="ti ti-layout-grid"></i> Ещё новости (${other.length})</h3>
                </div>
                <div class="news-feed-list">
                    ${buildNewsList(other)}
                </div>
            </div>
        `;
    }

    if (!latest.length && !other.length && fallbackItems.length) {
        html = `
            <div class="card">
                <div class="card-header">
                    <h3><i class="ti ti-news"></i> Лента новостей Shikimori</h3>
                </div>
                <div class="news-feed-list">
                    ${buildNewsList(fallbackItems)}
                </div>
            </div>
        `;
    }

    container.innerHTML = html;
}

const STATUS_MAP = {
    'watching': { anime: 'Смотрю', manga: 'Читаю', class: 'badge-watching' },
    'completed': { anime: 'Просмотрено', manga: 'Прочитано', class: 'badge-completed' },
    'planned': { anime: 'В планах', manga: 'В планах', class: 'badge-planned' },
    'on_hold': { anime: 'Отложено', manga: 'Отложено', class: 'badge-on_hold' },
    'dropped': { anime: 'Брошено', manga: 'Брошено', class: 'badge-dropped' },
    'rewatching': { anime: 'Пересматриваю', manga: 'Перечитываю', class: 'badge-watching' }
};

function switchListType(type) {
    currentTargetType = type;
    localStorage.setItem('currentTargetType', type);

    document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
    if (window.event && window.event.currentTarget) {
        window.event.currentTarget.classList.add('active');
    }
    
    updateFilterLabels();
    applyListFilters();
}

function filterListStatus(status, btn) {
    currentStatusFilter = status;
    localStorage.setItem('currentStatusFilter', status);

    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    applyListFilters();
}

function changeListSort(sortVal) {
    currentSortFilter = sortVal;
    localStorage.setItem('currentSortFilter', sortVal);
    applyListFilters();
}

function updateFilterLabels() {
    const isAnime = currentTargetType === 'Anime';
    const lblWatching = document.getElementById('lbl-watching');
    const lblCompleted = document.getElementById('lbl-completed');
    if (lblWatching) lblWatching.textContent = isAnime ? 'Смотрю' : 'Читаю';
    if (lblCompleted) lblCompleted.textContent = isAnime ? 'Просмотрено' : 'Прочитано';
}

function renderRatesView() {
    const container = document.getElementById('rates');
    if (!Array.isArray(ratesDataCache) || ratesDataCache.length === 0) {
        container.innerHTML = '<div class="card"><p style="color: var(--text-muted);">Список пуст</p></div>';
        return;
    }

    const isAnime = currentTargetType === 'Anime';

    container.innerHTML = `
        <div class="list-controls">
            <div class="type-switch">
                <button class="type-btn ${isAnime ? 'active' : ''}" onclick="switchListType('Anime')"><i class="ti ti-movie"></i> Аниме</button>
                <button class="type-btn ${!isAnime ? 'active' : ''}" onclick="switchListType('Manga')"><i class="ti ti-book"></i> Манга</button>
            </div>

            <div class="filter-sort-bar">
                <div class="rates-filters">
                    <button class="filter-btn ${currentStatusFilter === 'all' ? 'active' : ''}" onclick="filterListStatus('all', this)">Все (<span id="cnt-all">0</span>)</button>
                    <button id="lbl-watching" class="filter-btn ${currentStatusFilter === 'watching' ? 'active' : ''}" onclick="filterListStatus('watching', this)">Смотрю</button>
                    <button id="lbl-completed" class="filter-btn ${currentStatusFilter === 'completed' ? 'active' : ''}" onclick="filterListStatus('completed', this)">Просмотрено</button>
                    <button class="filter-btn ${currentStatusFilter === 'planned' ? 'active' : ''}" onclick="filterListStatus('planned', this)">В планах</button>
                    <button class="filter-btn ${currentStatusFilter === 'on_hold' ? 'active' : ''}" onclick="filterListStatus('on_hold', this)">Отложено</button>
                    <button class="filter-btn ${currentStatusFilter === 'dropped' ? 'active' : ''}" onclick="filterListStatus('dropped', this)">Брошено</button>
                </div>

                <select id="rates-sort" class="sort-select" onchange="changeListSort(this.value)">
                    <option value="updated_at" ${currentSortFilter === 'updated_at' ? 'selected' : ''}>По дате обновления</option>
                    <option value="score_desc" ${currentSortFilter === 'score_desc' ? 'selected' : ''}>По оценке (сначала высокие)</option>
                    <option value="score_asc" ${currentSortFilter === 'score_asc' ? 'selected' : ''}>По оценке (сначала низкие)</option>
                    <option value="name" ${currentSortFilter === 'name' ? 'selected' : ''}>По названию (А-Я)</option>
                    <option value="episodes" ${currentSortFilter === 'episodes' ? 'selected' : ''}>По прогрессу</option>
                </select>
            </div>
        </div>
        <div id="rates-grid-container" class="rates-grid"></div>
    `;

    updateFilterLabels();
    applyListFilters();
}

function sortRatesList(rates, criterion) {
    return [...rates].sort((a, b) => {
        const targetA = a.target_data || a.anime || a.manga || {};
        const targetB = b.target_data || b.anime || b.manga || {};

        switch (criterion) {
            case 'score_desc':
                return (b.score || 0) - (a.score || 0);
            case 'score_asc':
                return (a.score || 0) - (b.score || 0);
            case 'name': {
                const titleA = targetA.russian || targetA.name || '';
                const titleB = targetB.russian || targetB.name || '';
                return titleA.localeCompare(titleB, 'ru');
            }
            case 'episodes': {
                const progressA = a.episodes ?? a.chapters ?? 0;
                const progressB = b.episodes ?? b.chapters ?? 0;
                return progressB - progressA;
            }
            case 'updated_at':
            default: {
                const dateA = new Date(a.updated_at || 0).getTime();
                const dateB = new Date(b.updated_at || 0).getTime();
                return dateB - dateA;
            }
        }
    });
}

function applyListFilters() {
    const byType = ratesDataCache.filter(r => r.target_type === currentTargetType);
    const cntAll = document.getElementById('cnt-all');
    if (cntAll) cntAll.textContent = byType.length;

    let filtered = currentStatusFilter === 'all' 
        ? byType 
        : byType.filter(r => r.status === currentStatusFilter);

    filtered = sortRatesList(filtered, currentSortFilter);

    renderListGrid(filtered);
}

function renderListGrid(items) {
    const grid = document.getElementById('rates-grid-container');
    if (!grid) return;

    if (!items.length) {
        grid.innerHTML = '<p style="color: var(--text-muted); grid-column: 1 / -1;">Записей в этой категории не найдено</p>';
        return;
    }

    grid.innerHTML = items.map(rate => {
        const targetObj = rate.target_data || rate.anime || rate.manga || {};
        const isAnime = rate.target_type === 'Anime';
        const pathPrefix = isAnime ? 'animes' : 'mangas';
        
        const targetUrl = targetObj.url 
            ? (targetObj.url.startsWith('http') ? targetObj.url : 'https://shikimori.io' + targetObj.url) 
            : `https://shikimori.io/${pathPrefix}/${rate.target_id}`;
        
        const targetName = targetObj.russian || targetObj.name || `#${rate.target_id}`;
        const imgUrl = targetObj.image ? buildImgUrl(targetObj.image) : '';

        const statusInfo = STATUS_MAP[rate.status] || { anime: rate.status, manga: rate.status, class: 'badge-planned' };
        const statusLabel = isAnime ? statusInfo.anime : statusInfo.manga;
        const scoreText = rate.score ? `<i class="ti ti-star-filled"></i> ${rate.score}/10` : '—';

        let progressText = '—';
        if (isAnime) {
            const totalEp = targetObj.episodes || '?';
            if (rate.episodes !== undefined) progressText = `${rate.episodes} / ${totalEp} эп.`;
        } else {
            const totalCh = targetObj.chapters || '?';
            if (rate.chapters !== undefined) progressText = `${rate.chapters} / ${totalCh} гл.`;
        }

        if (rate.rewatches > 0) {
            progressText += ` (повторов: ${rate.rewatches})`;
        }

        const thumbHtml = imgUrl 
            ? `<a href="${targetUrl}" target="_blank"><img src="${imgUrl}" alt="${targetName}" class="history-thumb" loading="lazy"></a>`
            : `<div class="history-thumb-placeholder"></div>`;

        return `
            <div class="rate-card">
                ${thumbHtml}
                <div class="rate-content">
                    <div class="rate-header">
                        <a href="${targetUrl}" target="_blank" class="rate-title" title="${targetName}">${targetName}</a>
                        <span class="badge ${statusInfo.class}">${statusLabel}</span>
                    </div>
                    <div class="info-row" style="padding: 2px 0;">
                        <span class="label">Прогресс:</span>
                        <span><b>${progressText}</b></span>
                    </div>
                    <div class="info-row" style="padding: 2px 0;">
                        <span class="label">Оценка:</span>
                        <span class="score-pill">${scoreText}</span>
                    </div>
                    ${rate.text ? `<div style="font-size: 12px; color: var(--text-muted); font-style: italic; margin-top: 2px;">"${rate.text}"</div>` : ''}
                </div>
            </div>
        `;
    }).join('');
}

document.addEventListener('DOMContentLoaded', () => {
    initTheme();
    loadRecentHistory();
    loadProfileFriendsClubs();

    const savedTab = localStorage.getItem('activeTab') || 'profile';
    openTab(savedTab);

    document.querySelectorAll('.shiki-grid').forEach(async (grid) => {
        const type = grid.dataset.type;
        const ids = grid.dataset.ids;
        if (!ids) return;

        try {
            const response = await fetch(`/api/grid-data?type=${type}&ids=${ids}`);
            const items = await response.json();
            if (!Array.isArray(items)) return;

            grid.innerHTML = items.map(item => {
                const title = item.russian || item.name || '';
                const imgUrl = buildImgUrl(item.image);
                const itemUrl = item.url ? `https://shikimori.io${item.url}` : `https://shikimori.io/${type}/${item.id}`;

                return `
                    <a href="${itemUrl}" target="_blank" class="shiki-grid-item" title="${title}">
                        <img src="${imgUrl}" alt="${title}" loading="lazy">
                        <div class="item-title">${title}</div>
                    </a>
                `;
            }).join('');
        } catch (err) {
            console.error('Ошибка загрузки сетки:', err);
        }
    });
});