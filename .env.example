# Flask Configuration
FLASK_SECRET_KEY=change_this_to_a_random_secret_string

# Shikimori OAuth 2.0 Credentials
# Get your Client ID and Client Secret at: https://shikimori.one/oauth/applications
SHIKIMORI_CLIENT_ID=your_shikimori_client_id_here
SHIKIMORI_CLIENT_SECRET=your_shikimori_client_secret_here
SHIKIMORI_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
SHIKIMORI_APP_NAME=ShikiMXApp/1.0

# Optional: Disable custom console/file logging (true/false)
DISABLE_CUSTOM_LOGGING=false
